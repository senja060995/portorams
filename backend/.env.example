# RAMS Backend Environment Configuration Example

# Server Port
PORT=8080

# Database Configuration (PostgreSQL DSN / DATABASE_URL)
# DATABASE_URL=postgres://user:password@localhost:5432/rams_db?sslmode=disable
# POSTGRES_DSN=host=localhost user=postgres password=postgres dbname=rams_db port=5432 sslmode=disable

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Environment Mode (development / release)
GIN_MODE=release
