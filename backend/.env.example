# RAMS Backend Environment Configuration

# HTTP port
PORT=8080

# App environment: development | production
APP_ENV=development

# --- Database ---------------------------------------------------------------
# Leave both unset to use local SQLite (SQLITE_PATH, default ./rams.db)
# DATABASE_URL=postgres://user:password@localhost:5432/rams_db?sslmode=disable
# POSTGRES_DSN=host=localhost user=postgres password=postgres dbname=rams_db port=5432 sslmode=disable
SQLITE_PATH=rams.db

# --- Security ---------------------------------------------------------------
# REQUIRED. Minimum 32 characters. The server refuses to start without it.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Comma separated list of exact frontend origins. Wildcards are rejected.
ALLOWED_ORIGINS=http://localhost:3000

# --- Wallet sign-in (SIWE / MetaMask) ---------------------------------------
# Comma separated EVM addresses that may log in to the CMS. Each entry may
# carry a ":role" suffix (admin|editor); the first entry defaults to admin.
# Addresses are validated (EIP-55) at seed time and stored lowercase.
ALLOWED_WALLETS=

# The exact domain and URI bound into every signed message. Both must match
# the origin where the admin panel is served.
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000

# Chain that must be active in the wallet during sign-in (1 = Ethereum mainnet)
EXPECTED_CHAIN_ID=1

# Legacy username/password login. Keep false: the CMS is wallet-only.
ENABLE_PASSWORD_LOGIN=false

# --- Security alerts ---------------------------------------------------------
# Optional. When both are set, security events (failed wallet logins, lockouts,
# invalid signatures) are pushed to a Telegram chat. Leave empty to disable.
# Create a bot with @BotFather and get the chat id (e.g. via @userinfobot).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Media uploads ----------------------------------------------------------
UPLOAD_DIR=uploads
# Absolute base URL of this API, used to build public upload URLs
PUBLIC_API_URL=http://localhost:8080

# --- AI chat (customer service bot) -----------------------------------------
# OpenAI-compatible provider. Defaults to Groq. Leave AI_API_KEY empty to
# keep using the built-in keyword bot.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
